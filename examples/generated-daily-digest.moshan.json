{
  "$schema": "https://moshan.dev/schema/moshan-2.1.json",
  "spec": "2.1",
  "id": "daily-digest",
  "name": "每日信息摘要",
  "version": "0.1.0",
  "summary": "公众号与 RSS 自动进笔记库，可检索，顺带记 token 账",
  "description": "由蓝图 examples/daily-digest.json 解析生成，能力目录 2026-11-24。改动请改蓝图，不要改本文件——它是产物。",
  "author": {
    "name": "pamphile"
  },
  "license": "MIT",
  "kind": "stack",
  "category": "组合栈",
  "catalog_category": "agent-plugin",
  "tags": [
    "download",
    "data",
    "search",
    "ai",
    "selfhost"
  ],
  "group": "plugin",
  "keywords": [
    "ai",
    "news",
    "note",
    "search"
  ],
  "permissions": [
    "docker",
    "fs:新闻摘录",
    "net:https",
    "net:127.0.0.1",
    "exec:python3"
  ],
  "requires": {
    "moshan": ">=2.1"
  },
  "port": 8790,
  "ui": {
    "path": "/",
    "embed": "iframe",
    "open": "panel"
  },
  "health": {
    "path": "/api/ping",
    "interval": 30,
    "timeout": 3
  },
  "cards": {
    "api": "/api/cards"
  },
  "data": {
    "env": "DIGEST_DIR",
    "default": "~/Documents/AI项目/_栈/daily-digest"
  },
  "components": [
    {
      "id": "wechat-scholar",
      "name": "Wechat-Scholar",
      "kind": "process",
      "source": "https://github.com/osnsyc/Wechat-Scholar",
      "expose": 8791,
      "provides": [
        {
          "name": "webui",
          "port": 8791,
          "protocol": "http"
        }
      ],
      "runtime": {
        "entry": "feed_server.py",
        "args": [
          "--port",
          "${port}"
        ],
        "restart": "on-failure"
      },
      "health": {
        "url": "http://127.0.0.1:8791/",
        "expect_status": 200
      }
    },
    {
      "id": "siyuan",
      "name": "思源笔记",
      "kind": "container",
      "version": "v3.1.11",
      "source": "https://github.com/siyuan-note/siyuan",
      "expose": 8792,
      "provides": [
        {
          "name": "webui",
          "port": 6806,
          "protocol": "http"
        }
      ],
      "env": {
        "SIYUAN_ACCESS_AUTH_CODE": "${secret}"
      },
      "image": "b3log/siyuan:v3.1.11",
      "health": {
        "url": "http://127.0.0.1:8792/",
        "expect_status": 200
      }
    },
    {
      "id": "meilisearch",
      "name": "Meilisearch",
      "kind": "container",
      "version": "v1.11",
      "source": "https://github.com/meilisearch/meilisearch",
      "expose": 8793,
      "provides": [
        {
          "name": "api",
          "port": 7700,
          "protocol": "http"
        }
      ],
      "env": {
        "MEILI_MASTER_KEY": "${secret}",
        "MEILI_NO_ANALYTICS": "true"
      },
      "image": "getmeili/meilisearch:v1.11",
      "health": {
        "url": "http://127.0.0.1:8793/",
        "expect_status": 200
      }
    },
    {
      "id": "llmcost",
      "name": "LLM 算价",
      "kind": "process",
      "source": "https://github.com/pamphile/moshan-llmcost",
      "expose": 8794,
      "provides": [
        {
          "name": "api",
          "port": 8794,
          "protocol": "http"
        }
      ],
      "runtime": {
        "entry": "llmcost.py",
        "args": [
          "--serve",
          "--no-open",
          "--port",
          "${port}"
        ],
        "restart": "on-failure"
      },
      "health": {
        "url": "http://127.0.0.1:8794/",
        "expect_status": 200
      }
    },
    {
      "id": "hub",
      "name": "摘要胶水",
      "kind": "process",
      "source": "本插件自带（custom 格）",
      "runtime": {
        "entry": "hub/main.py",
        "args": [
          "--serve",
          "--no-open",
          "--port",
          "${port}"
        ],
        "restart": "always"
      },
      "expose": 8790,
      "provides": [
        {
          "name": "api",
          "port": 8790,
          "protocol": "http"
        }
      ],
      "volumes": [
        {
          "host": "${data}/hub",
          "container": "/app/data"
        }
      ],
      "health": {
        "url": "http://127.0.0.1:8790/api/ping",
        "expect_body": "ok"
      }
    }
  ],
  "wires": [
    {
      "from": {
        "component": "wechat-scholar",
        "port": "webui"
      },
      "to": {
        "component": "hub",
        "env": "NEWS_SOURCE_URL"
      },
      "protocol": "http",
      "capability": "news.fetch",
      "note": "胶水每小时拉一次 feed，按 URL 与标题双指纹去重"
    },
    {
      "from": {
        "component": "siyuan",
        "port": "webui"
      },
      "to": {
        "component": "hub",
        "env": "SIYUAN_URL"
      },
      "protocol": "http",
      "capability": "note.store",
      "note": "调 /api/filetree/createDocWithMd 落档，先查 SQL 看标题是否已存在"
    },
    {
      "from": {
        "component": "meilisearch",
        "port": "api"
      },
      "to": {
        "component": "hub",
        "env": "MEILI_URL"
      },
      "protocol": "http",
      "capability": "search.fulltext",
      "note": "文档推 POST /indexes/notes/documents，走异步任务队列"
    },
    {
      "from": {
        "component": "llmcost",
        "port": "api"
      },
      "to": {
        "component": "hub",
        "env": "LLMCOST_URL"
      },
      "protocol": "http",
      "capability": "ai.usage",
      "note": "每次摘要后回报 token，卡片上显示今日花费"
    }
  ],
  "extensions": {
    "cn.moshan.blueprint": {
      "blueprint": "daily-digest",
      "catalog_updated": "2026-11-24",
      "slots": [
        {
          "slot": "src",
          "label": "采集",
          "needs": [
            "news.fetch"
          ],
          "resolved": "wechat-scholar",
          "modules": [
            "feed"
          ]
        },
        {
          "slot": "store",
          "label": "知识库",
          "needs": [
            "note.store",
            "note.edit"
          ],
          "resolved": "siyuan",
          "modules": [
            "store",
            "edit"
          ]
        },
        {
          "slot": "index",
          "label": "检索",
          "needs": [
            "search.fulltext"
          ],
          "resolved": "meilisearch",
          "modules": [
            "index"
          ]
        },
        {
          "slot": "usage",
          "label": "算价",
          "needs": [
            "ai.usage"
          ],
          "resolved": "llmcost",
          "modules": [
            "usage"
          ]
        },
        {
          "slot": "hub",
          "label": "摘要胶水",
          "needs": [
            "news.digest"
          ],
          "resolved": "custom",
          "modules": []
        }
      ],
      "gaps": []
    }
  }
}
