{
  "$schema": "https://moshan.dev/schema/catalog-1.json",
  "spec": "1.0",
  "name": "moshan 官方能力目录",
  "updated": "2026-11-24",
  "capabilities": [
    {
      "id": "media.download",
      "label": "下载",
      "group": "媒体",
      "desc": "把种子/链接变成磁盘上的文件"
    },
    {
      "id": "media.library",
      "label": "媒体库",
      "group": "媒体",
      "desc": "扫描目录、刮削元数据、生成可播放条目"
    },
    {
      "id": "media.stream",
      "label": "播放",
      "group": "媒体",
      "desc": "对外提供播放页面与串流接口"
    },
    {
      "id": "media.transcode",
      "label": "硬件转码",
      "group": "媒体",
      "desc": "借助 GPU 实时转码，弱设备也能播"
    },
    {
      "id": "media.music",
      "label": "音乐库",
      "group": "媒体",
      "desc": "音频专用库与客户端协议（Subsonic）"
    },
    {
      "id": "note.store",
      "label": "笔记存储",
      "group": "知识",
      "desc": "文档落盘与版本"
    },
    {
      "id": "note.edit",
      "label": "编辑器",
      "group": "知识",
      "desc": "人可写字的界面（Markdown/块编辑）"
    },
    {
      "id": "note.search",
      "label": "笔记内搜索",
      "group": "知识",
      "desc": "自带全文检索"
    },
    {
      "id": "search.fulltext",
      "label": "全文索引",
      "group": "知识",
      "desc": "独立检索引擎，中文分词友好"
    },
    {
      "id": "db.relational",
      "label": "关系库",
      "group": "基础",
      "desc": "PostgreSQL 协议的关系型数据库"
    },
    {
      "id": "cache.kv",
      "label": "键值缓存",
      "group": "基础",
      "desc": "Redis 协议的缓存/队列"
    },
    {
      "id": "storage.object",
      "label": "对象存储",
      "group": "基础",
      "desc": "S3 协议的文件桶"
    },
    {
      "id": "auth.vault",
      "label": "密码库",
      "group": "基础",
      "desc": "口令与密钥保管、自动填充"
    },
    {
      "id": "analytics.stats",
      "label": "访问统计",
      "group": "基础",
      "desc": "隐私友好的页面统计"
    },
    {
      "id": "news.fetch",
      "label": "信息抓取",
      "group": "采集",
      "desc": "把 RSS/公众号变成结构化条目"
    },
    {
      "id": "news.digest",
      "label": "摘要打分",
      "group": "采集",
      "desc": "去重、排序、生成每日摘要"
    },
    {
      "id": "ai.usage",
      "label": "用量记账",
      "group": "AI",
      "desc": "按会话统计 token 与花费"
    },
    {
      "id": "automation.glue",
      "label": "胶水逻辑",
      "group": "自定义",
      "desc": "把上面这些接起来的那几十行代码，通常没有现成软件"
    },
    {
      "id": "dev.runtime",
      "label": "桌面运行时",
      "group": "基座",
      "desc": "把 Web 或原生代码跑成桌面 / 本地应用的那一层"
    },
    {
      "id": "dev.build",
      "label": "语言与构建",
      "group": "基座",
      "desc": "决定二进制体积、启动速度与分发方式的底层选择"
    },
    {
      "id": "ai.protocol",
      "label": "Agent 互联协议",
      "group": "协议",
      "desc": "Agent 与工具、Agent 与 Agent、Agent 与界面之间的标准接口"
    }
  ],
  "entries": [
    {
      "id": "qbittorrent",
      "name": "qBittorrent",
      "repo": "qbittorrent/qBittorrent",
      "kind": "container",
      "image": "linuxserver/qbittorrent",
      "sample_tag": "4.6.7",
      "license": "GPL-2.0",
      "tier": "official",
      "cost": {
        "ram_mb": 120,
        "disk_gb": 1
      },
      "notes": "种子下载的事实标准，WebUI 有完整 REST API，胶水最爱接它。",
      "modules": [
        {
          "id": "torrent",
          "label": "BT/磁力下载",
          "capability": "media.download",
          "default": true,
          "port": {
            "name": "webui",
            "port": 8080,
            "protocol": "http"
          },
          "shared": {
            "name": "downloads",
            "container": "/downloads"
          },
          "config": {
            "WEBUI_PORT": "8080",
            "PUID": "501",
            "PGID": "20"
          },
          "note": "胶水每 30 秒查 /api/v2/torrents/info，挑出「已完成但未改名」的条目",
          "artifact": {
            "kind": "image",
            "ref": "linuxserver/qbittorrent:4.6.7",
            "size_mb": 190
          }
        }
      ],
      "tags": [
        "download",
        "network",
        "web",
        "selfhost"
      ]
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "repo": "jellyfin/jellyfin",
      "kind": "container",
      "image": "jellyfin/jellyfin",
      "sample_tag": "10.10.3",
      "license": "GPL-2.0",
      "tier": "official",
      "cost": {
        "ram_mb": 400,
        "disk_gb": 2
      },
      "notes": "完全开源、无账号、无付费墙。模块拆得最干净：库、播放、转码可以只要其中一个。",
      "modules": [
        {
          "id": "stream",
          "label": "播放与 WebUI",
          "capability": "media.stream",
          "default": true,
          "port": {
            "name": "webui",
            "port": 8096,
            "protocol": "http"
          },
          "note": "改名落盘后调 /Library/Refresh，让它立刻扫到新文件，不用等定时任务",
          "artifact": {
            "kind": "image",
            "ref": "jellyfin/jellyfin:10.10.3",
            "variants": {
              "vaapi": "jellyfin/jellyfin:10.10.3-vaapi",
              "nvidia": "jellyfin/jellyfin:10.10.3-nvidia"
            },
            "size_mb": 260
          }
        },
        {
          "id": "library",
          "label": "媒体库刮削",
          "capability": "media.library",
          "default": true,
          "port": {
            "name": "webui",
            "port": 8096,
            "protocol": "http"
          },
          "note": "靠共享目录拿文件，不靠网络地址，所以连法是卷不是 URL",
          "artifact": {
            "kind": "none",
            "note": "同一镜像内的媒体库管理，勾选即用，不额外下载"
          }
        },
        {
          "id": "transcode",
          "label": "VAAPI 硬转码",
          "capability": "media.transcode",
          "default": false,
          "port": {
            "name": "webui",
            "port": 8096,
            "protocol": "http"
          },
          "requires": [
            "media.library"
          ],
          "cost": {
            "ram_mb": 300,
            "gpu": true
          },
          "config": {
            "JELLYFIN_HWACCEL": "vaapi"
          },
          "note": "默认关闭。启用需透传 /dev/dri，镜像整体换成 -vaapi 变体（约 490MB，替换而非叠加）",
          "artifact": {
            "kind": "none",
            "variant": "vaapi",
            "size_mb": 490,
            "note": "整镜替换为 -vaapi 变体（含基础层），并透传 /dev/dri；不勾则仍用基础镜像"
          }
        }
      ],
      "tags": [
        "media",
        "web",
        "backend",
        "selfhost"
      ]
    },
