    {
      "id": "siyuan",
      "name": "思源笔记",
      "repo": "siyuan-note/siyuan",
      "kind": "container",
      "image": "b3log/siyuan",
      "sample_tag": "v3.1.11",
      "license": "AGPL-3.0",
      "tier": "official",
      "cost": {
        "ram_mb": 200,
        "disk_gb": 1
      },
      "notes": "块级编辑器 + 自带全文检索 + 完整 HTTP API，最适合当「知识沉淀」那一格。",
      "modules": [
        {
          "id": "store",
          "label": "文档存储",
          "capability": "note.store",
          "default": true,
          "port": {
            "name": "webui",
            "port": 6806,
            "protocol": "http"
          },
          "config": {
            "SIYUAN_ACCESS_AUTH_CODE": "${secret}"
          },
          "note": "胶水用 /api/filetree/createDocWithMd 写文档，用 /api/query/sql 查已有标题做去重",
          "artifact": {
            "kind": "image",
            "ref": "b3log/siyuan:v3.1.11",
            "size_mb": 180
          }
        },
        {
          "id": "edit",
          "label": "块编辑器",
          "capability": "note.edit",
          "default": true,
          "port": {
            "name": "webui",
            "port": 6806,
            "protocol": "http"
          },
          "artifact": {
            "kind": "none",
            "note": "编辑器是同一镜像的内置前端"
          }
        },
        {
          "id": "search",
          "label": "内置检索",
          "capability": "note.search",
          "default": false,
          "port": {
            "name": "webui",
            "port": 6806,
            "protocol": "http"
          },
          "note": "条目上千以后中文分词会变差，那时候再换 meilisearch",
          "artifact": {
            "kind": "none",
            "note": "内置搜索索引，勾选只打开开关"
          }
        }
      ],
      "tags": [
        "data",
        "ui",
        "desktop",
        "selfhost"
      ]
    },
    {
      "id": "meilisearch",
      "name": "Meilisearch",
      "repo": "meilisearch/meilisearch",
      "kind": "container",
      "image": "getmeili/meilisearch",
      "sample_tag": "v1.11",
      "license": "MIT",
      "tier": "official",
      "cost": {
        "ram_mb": 180,
        "disk_gb": 1
      },
      "modules": [
